PORT=5000
NODE_ENV=development

# Database Config (PostgreSQL / PgBouncer)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kh_lotto
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kh_lotto
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=2000

# Redis Config (for Socket.io multi-instance scaling & cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-kh-lotto-2026-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# KHQR / Bakong Settings
BAKONG_ACCOUNT_ID=merchant@devb
MERCHANT_NAME=KH-LOTTO CASINO
MERCHANT_CITY=Phnom Penh
WEBHOOK_SECRET=khqr-webhook-secret-token-production
